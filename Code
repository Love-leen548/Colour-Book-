      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = page.isBlank ? 'btn btn-mint' : 'btn btn-yellow';
      btn.textContent = page.isBlank ? 'Open Blank Canvas' : 'Color This Page';
      btn.addEventListener('click', () => {
        playPop();
        loadPage(page);
        document.getElementById('studio').scrollIntoView({ behavior: 'smooth' });
      });

      card.append(thumb, meta, btn);
      pagesGrid.appendChild(card);
    });

    // Build palette + Custom Color Wheel
    const paletteEl = document.getElementById('palette');
    const customColorInput = document.getElementById('customColorInput');

    function selectColor(hex, swatchEl = null) {
      currentColor = hex;
      if (hex !== 'RAINBOW') {
        customColorInput.value = hex;
      }
      if (activeTool === 'eraser' || activeTool === 'sticker') {
        setTool('brush');
      } else {
        setTool(activeTool);
      }
      document.querySelectorAll('.swatch').forEach((s) => s.classList.remove('selected'));
      if (swatchEl) swatchEl.classList.add('selected');
    }

    COLORS.forEach((hex, idx) => {
      const swatch = document.createElement('button');
      swatch.type = 'button';
      swatch.className = 'swatch' + (idx === 0 ? ' selected' : '') + (hex === 'RAINBOW' ? ' rainbow-swatch' : '');
      if (hex !== 'RAINBOW') {
        swatch.style.backgroundColor = hex;
      }
      swatch.setAttribute('aria-label', hex === 'RAINBOW' ? 'Magic Rainbow Brush' : `Color ${hex}`);
      swatch.title = hex === 'RAINBOW' ? 'Magic Rainbow Brush!' : hex;
      swatch.addEventListener('click', () => {
        playPop();
        selectColor(hex, swatch);
      });
      paletteEl.appendChild(swatch);
    });

    customColorInput.addEventListener('input', (e) => {
      selectColor(e.target.value, null);
    });

    // Brush size buttons
    document.querySelectorAll('.size-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        playPop();
        brushSize = Number(btn.dataset.size);
        document.querySelectorAll('.size-btn').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
      });
    });

    // Sticker buttons
    document.querySelectorAll('.sticker-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        playPop();
        selectedSticker = btn.dataset.sticker;
        setTool('sticker');
      });
    });

    // Tool buttons
    document.getElementById('brushBtn').addEventListener('click', () => {
      playPop();
      setTool('brush');
    });
    document.getElementById('bucketBtn').addEventListener('click', () => {
      playPop();
      setTool('bucket');
    });
    document.getElementById('eraserBtn').addEventListener('click', () => {
      playPop();
      setTool(activeTool === 'eraser' ? 'brush' : 'eraser');
    });

    document.getElementById('undoBtn').addEventListener('click', () => {
      if (history.length > 1) {
        playPop();
        history.pop();
        const prev = history[history.length - 1];
        paintCtx.putImageData(prev, 0, 0);
      }
    });

    document.getElementById('clearBtn').addEventListener('click', () => {
      playPop();
      fillWhiteBackground();
      pushHistory();
    });

    // Pointer logic
    function getCanvasPoint(e) {
      const rect = paintCanvas.getBoundingClientRect();
      const scaleX = paintCanvas.width / rect.width;
      const scaleY = paintCanvas.height / rect.height;
      return {
        x: (e.clientX - rect.left) * scaleX,
        y: (e.clientY - rect.top) * scaleY
      };
    }

    function drawSegment(from, to) {
      paintCtx.save();
      paintCtx.lineCap = 'round';
      paintCtx.lineJoin = 'round';
      paintCtx.lineWidth = brushSize;

      if (activeTool === 'eraser') {
        paintCtx.strokeStyle = '#ffffff';
      } else if (currentColor === 'RAINBOW') {
        rainbowHue = (rainbowHue + 6) % 360;
        paintCtx.strokeStyle = `hsl(${rainbowHue}, 92%, 56%)`;
      } else {
        paintCtx.strokeStyle = currentColor;
      }

      paintCtx.beginPath();
      paintCtx.moveTo(from.x, from.y);
      paintCtx.lineTo(to.x, to.y);
      paintCtx.stroke();
      paintCtx.restore();
    }

    paintCanvas.addEventListener('pointerdown', (e) => {
      e.preventDefault();
      const pt = getCanvasPoint(e);

      if (activeTool === 'bucket') {
        floodFillAt(pt.x, pt.y, currentColor);
        return;
      }

      if (activeTool === 'sticker') {
        stampStickerAt(pt.x, pt.y, selectedSticker);
        return;
      }

      paintCanvas.setPointerCapture(e.pointerId);
      isDrawing = true;
      lastPoint = pt;
      drawSegment(lastPoint, { x: lastPoint.x + 0.1, y: lastPoint.y + 0.1 });
    });

    paintCanvas.addEventListener('pointermove', (e) => {
      if (!isDrawing) return;
      const pt = getCanvasPoint(e);
      drawSegment(lastPoint, pt);
      lastPoint = pt;
    });

    function finishStroke() {
      if (!isDrawing) return;
      isDrawing = false;
      lastPoint = null;
      pushHistory();
    }

    paintCanvas.addEventListener('pointerup', finishStroke);
    paintCanvas.addEventListener('pointercancel', finishStroke);

    // Build combined image Data URL
    function getCombinedDataUrl() {
      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = paintCanvas.width;
      exportCanvas.height = paintCanvas.height;
      const eCtx = exportCanvas.getContext('2d');
      eCtx.drawImage(paintCanvas, 0, 0);
      if (!currentPage.isBlank) {
        eCtx.drawImage(lineCanvas, 0, 0);
      }
      return exportCanvas.toDataURL('image/png');
    }

    // My Saved Gallery (localStorage)
    const GALLERY_STORAGE_KEY = 'colorjoy_saved_gallery_v1';

    function loadSavedGallery() {
      try {
        return JSON.parse(localStorage.getItem(GALLERY_STORAGE_KEY)) || [];
      } catch (e) {
        return [];
      }
    }

    function saveGalleryItems(items) {
      try {
        localStorage.setItem(GALLERY_STORAGE_KEY, JSON.stringify(items));
      } catch (e) {
        alert('Gallery storage is full! Delete an older drawing to save a new one.');
      }
    }

    function renderGallery() {
      const container = document.getElementById('galleryContainer');
      const items = loadSavedGallery();

      if (items.length === 0) {
        container.innerHTML = `
          <div class="empty-gallery">
            🖼️ No saved drawings yet! Color a picture above and click <strong>Save to Gallery</strong> to showcase your art here.
          </div>
        `;
        return;
      }

      const grid = document.createElement('div');
      grid.className = 'gallery-grid';

      items.forEach((item) => {
        const card = document.createElement('article');
        card.className = 'gallery-card';

        const thumb = document.createElement('div');
        thumb.className = 'thumb-box';
        const img = document.createElement('img');
        img.src = item.combinedDataUrl;
        img.alt = item.title;
        img.style.maxWidth = '100%';
        img.style.maxHeight = '100%';
        thumb.appendChild(img);

        const meta = document.createElement('div');
        meta.className = 'page-meta';
        meta.innerHTML = `<h3 style="font-size:1.08rem;">${item.title}</h3><span class="tag">${item.date}</span>`;

        const actions = document.createElement('div');
        actions.className = 'gallery-actions';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'btn btn-sky btn-sm';
        editBtn.textContent = '✏️ Open';
        editBtn.addEventListener('click', () => {
          playPop();
          const matchedPage = PAGES.find((p) => p.id === item.pageId) || PAGES[PAGES.length - 1];
          loadPage(matchedPage, item.paintDataUrl);
          document.getElementById('studio').scrollIntoView({ behavior: 'smooth' });
        });

        const dlBtn = document.createElement('button');
        dlBtn.type = 'button';
        dlBtn.className = 'btn btn-mint btn-sm';
        dlBtn.textContent = '💾 PNG';
        dlBtn.addEventListener('click', () => {
          const a = document.createElement('a');
          a.download = `${item.pageId}-gallery.png`;
          a.href = item.combinedDataUrl;
          a.click();
        });

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'btn btn-sm';
        delBtn.style.background = '#ffe5ec';
        delBtn.textContent = '🗑️';
        delBtn.title = 'Delete drawing';
        delBtn.addEventListener('click', () => {
          playPop();
          const updated = loadSavedGallery().filter((entry) => entry.id !== item.id);
          saveGalleryItems(updated);
          renderGallery();
        });

        actions.append(editBtn, dlBtn, delBtn);
        card.append(thumb, meta, actions);
        grid.appendChild(card);
      });

      container.innerHTML = '';
      container.appendChild(grid);
    }

    document.getElementById('saveGalleryBtn').addEventListener('click', () => {
      playFanfare();
      launchConfetti();

      const items = loadSavedGallery();
      const now = new Date();
      const dateStr = now.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });

      items.unshift({
        id: Date.now(),
        pageId: currentPage.id,
        title: currentPage.title,
        date: dateStr,
        paintDataUrl: paintCanvas.toDataURL('image/png'),
        combinedDataUrl: getCombinedDataUrl()
      });

      // Keep up to 12 saved drawings so localStorage stays fast
      saveGalleryItems(items.slice(0, 12));
      renderGallery();
      document.getElementById('gallery').scrollIntoView({ behavior: 'smooth' });
    });

    // Download PNG + Confetti + Fanfare
    document.getElementById('downloadBtn').addEventListener('click', () => {
      playFanfare();
      launchConfetti();

      const link = document.createElement('a');
      link.download = `${currentPage.id}-coloring.png`;
      link.href = getCombinedDataUrl();
      link.click();
    });

    // Print
    document.getElementById('printBtn').addEventListener('click', () => {
      playPop();
      window.print();
    });

    // Initialize
    setTool('brush');
    loadPage(PAGES[0]);
    renderGallery();
  </script>
</body>
</html>
