    function hexToRgb(hex) {
      if (hex === 'RAINBOW') {
        const randomPalette = ['#ff5d8f', '#ff9f1c', '#ffd166', '#06d6a0', '#4cc9f0', '#9b5de5'];
        hex = randomPalette[Math.floor(Math.random() * randomPalette.length)];
      }
      const clean = hex.replace('#', '');
      const num = parseInt(clean, 16);
      return {
        r: (num >> 16) & 255,
        g: (num >> 8) & 255,
        b: num & 255
      };
    }

    function floodFillAt(startX, startY, fillHex) {
      const w = paintCanvas.width;
      const h = paintCanvas.height;
      const sx = Math.floor(startX);
      const sy = Math.floor(startY);
      if (sx < 0 || sx >= w || sy < 0 || sy >= h) return;

      const paintImg = paintCtx.getImageData(0, 0, w, h);
      const lineImg = lineCtx.getImageData(0, 0, w, h);
      const pData = paintImg.data;
      const lData = lineImg.data;

      const startIdx = (sy * w + sx) * 4;
      const targetR = pData[startIdx];
      const targetG = pData[startIdx + 1];
      const targetB = pData[startIdx + 2];

      const { r: fillR, g: fillG, b: fillB } = hexToRgb(fillHex);

      const isLinePixel = (idx) => lData[idx + 3] > 90 && lData[idx] < 80 && lData[idx + 1] < 80 && lData[idx + 2] < 95;
      if (isLinePixel(startIdx)) return;
      if (targetR === fillR && targetG === fillG && targetB === fillB) return;

      const tol = 28;
      const matchesTarget = (idx) =>
        Math.abs(pData[idx] - targetR) <= tol &&
        Math.abs(pData[idx + 1] - targetG) <= tol &&
        Math.abs(pData[idx + 2] - targetB) <= tol;

      const visited = new Uint8Array(w * h);
      const stack = [[sx, sy]];

      while (stack.length > 0) {
        let [x, y] = stack.pop();
        let rowStart = y * w;

        while (x >= 0) {
          const idx = (rowStart + x) * 4;
          if (visited[rowStart + x] || isLinePixel(idx) || !matchesTarget(idx)) break;
          x--;
        }
        x++;

        let spanAbove = false;
        let spanBelow = false;

        while (x < w) {
          const pIndex = rowStart + x;
          const idx = pIndex * 4;
          if (visited[pIndex] || isLinePixel(idx) || !matchesTarget(idx)) break;

          visited[pIndex] = 1;
          pData[idx] = fillR;
          pData[idx + 1] = fillG;
          pData[idx + 2] = fillB;
          pData[idx + 3] = 255;

          if (y > 0) {
            const upPIndex = pIndex - w;
            const upIdx = upPIndex * 4;
            const upValid = !visited[upPIndex] && !isLinePixel(upIdx) && matchesTarget(upIdx);
            if (!spanAbove && upValid) {
              stack.push([x, y - 1]);
              spanAbove = true;
            } else if (spanAbove && !upValid) {
              spanAbove = false;
            }
          }

          if (y < h - 1) {
            const downPIndex = pIndex + w;
            const downIdx = downPIndex * 4;
            const downValid = !visited[downPIndex] && !isLinePixel(downIdx) && matchesTarget(downIdx);
            if (!spanBelow && downValid) {
              stack.push([x, y + 1]);
              spanBelow = true;
            } else if (spanBelow && !downValid) {
              spanBelow = false;
            }
          }

          x++;
        }
      }

      paintCtx.putImageData(paintImg, 0, 0);
      playSplash();
      pushHistory();
    }

    function stampStickerAt(x, y, emoji) {
